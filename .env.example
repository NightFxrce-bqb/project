# Environment Variables

# Server
PORT=3000

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=pifpafai_bloggers

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-me

# APIFAY (optional - uses mock data if not set)
APIFAY_API_KEY=your_apifay_api_key